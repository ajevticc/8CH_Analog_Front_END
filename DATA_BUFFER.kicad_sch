	(text "Shiftreg DATA buffer.\n- DIR=1 (A->B), powered from Vcca (3.3V)\n- Each SER_DATA line handles a chain of 3x8-bit SRs (24-bits in total)\n- The above gives 16ns x 24 = 500ns update time (62.5 MHz CLK, abort gap is 3us)\n- Two SER_DATA lines go to a single AFE block (one for channel A, one for channel B)"
		(exclude_from_sim no)
		(at 133.604 51.308 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "df5a28c6-0b08-48c7-9f11-8ef5539cf26a")
	)
